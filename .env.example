# Copy to .env and fill in locally. Never commit real values.
# Server-side only (used by server/ for the incident-interpretation call):
LLM_PROVIDER=
LLM_API_KEY=
# Client-side (Phase 5, ArcGIS map):
VITE_ARCGIS_API_KEY=
# Optional features (client-side). Set to "off" to hide:
# G5 truck-route check: the Caltrans truck network record on each response.
VITE_TRUCK_NETWORK_CHECK=
