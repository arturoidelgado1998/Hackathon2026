# Copy to .env and fill in locally. Never commit real values.
# Server-side only (used by server/ for the incident-interpretation call):
# LLM_PROVIDER chooses the model service. Set it to "anthropic" for the Claude
# API; any other value uses an OpenAI-compatible endpoint, such as AI Squared's Bolt.
LLM_PROVIDER=
# OpenAI-compatible endpoint (Bolt):
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Claude API (used only when LLM_PROVIDER is "anthropic"). The model is optional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Client-side (Phase 5, ArcGIS map):
VITE_ARCGIS_API_KEY=
# Optional features (client-side). Set to "off" to hide:
# G5 truck-route check: the Caltrans truck network record on each response.
VITE_TRUCK_NETWORK_CHECK=
# Optional. Most AI calls the server makes in any 60 seconds (default 30).
AI_MAX_PER_MINUTE=
# Optional. The access key other devices need for the relays when the dev
# server runs with --host. Left empty, a new key is made at each start and
# is already in the links the pages show. 6 to 64 letters and digits.
RELAY_KEY=
